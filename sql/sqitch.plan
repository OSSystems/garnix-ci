%syntax-version=1.0.0
%project=garnix

init 2026-05-20T00:00:00Z Julian K. Arni <julian.arni@artificial.io> # Initialize tables
drop_billing_and_hetzner_schema [init] 2026-08-28T20:03:57Z Samuel Silva <samuel@ossystems.com.br> # Reconcile databases initialised before init stopped creating the billing and Hetzner schema; a no-op on a fresh database, but on an older one it drops those structures together with any orphaned billing and server rows still in them, and the revert recreates the structures empty without restoring their contents.
drop_installations [init] 2026-09-01T00:00:00Z Samuel Silva <samuel@ossystems.com.br> # Drop the billing-era installations table
github_user_credentials [init] 2026-09-01T12:00:00Z Samuel Silva <samuel@ossystems.com.br> # Hold the github user oauth credentials server-side so that the access token can be renewed with its refresh token; sessions minted before this change carry their token in the jwt instead and stop working, so everyone has to log in once more.
cache_lru_gc [init] 2026-09-03T00:00:00Z Samuel Silva <samuel@ossystems.com.br> # Add LRU/GC bookkeeping for the S3 binary cache: a deleting_since tombstone on cache_store_hashes, a normalised cache_store_hash_references edge table backfilled from the existing text column, supporting indexes, and a singleton cache_gc_state row recording when read-tracking began and holding the collector lease. The revert drops only these derived structures; store paths already collected by a GC pass are not restored.
commit_failure_comment [init] 2026-09-03T00:00:00Z Samuel Silva <samuel@ossystems.com.br> # Track whether the pull request failure comment was already posted for a commit
